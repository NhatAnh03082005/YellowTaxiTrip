* text=auto

# Reproducible text fixtures and source files across Windows/Linux
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Binary data and visual artifacts
*.parquet binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pbix binary
*.shp binary
*.shx binary
*.dbf binary

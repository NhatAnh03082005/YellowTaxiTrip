# Docker Compose project
COMPOSE_PROJECT_NAME=nyc_taxi_bi

# PostgreSQL/PostGIS
POSTGRES_DB=nyc_taxi
POSTGRES_USER=nyc_taxi
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port is 5433 because port 5432 is already used on the tested machine.
# Teammates may choose another free host port; container port remains 5432.
POSTGRES_HOST_PORT=5433

# DDS sort/hash budget per operation in each dbt connection (not a server setting).
# Native controller defaults to 32; empty keeps existing connection settings.
DBT_WORK_MEM_MB=32
# Profile example defaults to the measured DDS configuration; existing profiles
# keep their own settings. Override deliberately when benchmarking other values.
DBT_THREADS=2

# Mage
MAGE_PORT=6789
MAGE_PROJECT_NAME=nyc_taxi_bi
# docker-compose derives PYTHONPATH from MAGE_PROJECT_NAME; do not add a host path.
